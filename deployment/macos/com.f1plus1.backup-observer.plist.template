<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.f1plus1.backup-observer</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__BACKUP_TOOLS__/backup-off-host-observe.sh</string>
		<string>__BACKUP_RUNTIME__</string>
		<string>__BACKUP_RUNTIME_SHA256__</string>
		<string>__NODE24__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StartInterval</key>
	<integer>20</integer>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
