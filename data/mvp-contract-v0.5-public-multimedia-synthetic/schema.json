  "$id": "urn:f1plus1:public-read:v0.2-multimedia-synthetic",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Presentation DTO schema only. It adds no domain entity and does not mutate v0.4.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PublicFeedItemV2"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PublicPageV1Compatible"
        },
        "schemaVersion": {
          "const": "public-read-v0.2"
        }
      },
      "required": [
        "schemaVersion",
        "items",
        "page"
      ],
      "title": "Feed response",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "relatedItems": {
          "items": {
            "$ref": "#/$defs/PublicFeedItemV2"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": "public-read-v0.2"
        },
        "story": {
