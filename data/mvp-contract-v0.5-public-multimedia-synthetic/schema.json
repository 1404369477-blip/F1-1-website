                "cursorId": {
                  "type": "string"
                }
              },
              "required": [
                "cursorAt",
                "cursorId"
              ],
              "type": "object"
            }
          ]
        },
        "pageSize": {
          "const": 12
        }
      },
      "required": [
        "pageSize",
        "hasMore",
        "nextCursor"
      ],
      "type": "object"
