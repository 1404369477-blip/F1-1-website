  "cursor_contract": {
    "role": "adapter runtime receipt referenced by SourceObservation.cursor_ref; not a domain/Base field set",
    "fields": [
      "etag",
      "last_modified",
      "last_seen_external_id",
      "response_hash",
      "committed_at"
    ],
    "canonical_rule": "canonical-json-v1; cursor_ref = cursor:sha256:<lowercase hex>",
    "commit_rule": "advance only in the same successful transaction that persists all validated new observations and inbox intent",
    "no_advance_on": [
      "timeout",
      "network_error",
      "http_429",
      "http_5xx",
      "invalid_xml",
      "partial_parse",
      "schema_error",
      "stale_source_epoch",
      "authorization_or_stop_gate"
    ],
    "http_304": "record successful poll health but do not create a SourceObservation or change last_collected_at"
  },
  "dedupe_contract": {
    "primary_identity": [
      "source_id",
      "external_id"
    ],
    "external_id_precedence": [
      "non-empty GUID or Atom ID",
      "normalized canonical entry URL"
    ],
    "hard_failure": "missing both stable external ID and canonical URL",
    "idempotency_encoding": "sha256(UTF8(source_id + U+001F + external_id))",
    "content_update_detection": "recompute Content content_version_hash; same external identity with changed accepted content hash creates a new Content version, not a second source identity",
    "cross_source_event": "use proposed event-dedup-v1 only after Content normalization; do not overwrite source-scoped identity"
  },
  "time_contract": {
    "published_at": "source-provided RFC3339 or authorized page metadata; otherwise null",
    "observed_at": "collector clock at first successful observation",
    "timestamp_confidence": [
      "source",
      "page_metadata",
      "inferred",
      "unknown"
    ],
    "discovery_latency_ms": "observed_at - published_at",
    "slo_target_ms": 900000,
    "slo_eligible": "published_at != null and timestamp_confidence in [source,page_metadata]",
    "current_candidate": "not eligible from feed-only historical evidence because pubDate was absent"
  },
  "media_policy": {
    "default_rights_status": "unknown",
    "permitted_current_action": "retain zero media objects and the original content link only",
    "forbidden_until_authorized": [
      "download",
      "proxy",
      "permanent_store",
      "derive_license",
      "treat enclosure presence as permission"
    ],
    "review_exit": "rights evidence must name owner, scope, checked_at and evidence pointer before MediaCandidate can leave rights_unknown/review"
  },
  "retry_contract": {
    "retryable": {
      "network_timeout": [
        60,
        300,
        900
      ],
      "http_500_599": [
        60,
        300,
        900
      ],
      "http_429": "honor valid Retry-After; clamp to 60..3600 seconds"
    },
    "non_retryable_until_change": [
      "http_401",
      "http_403",
      "invalid_authorization",
      "blocked_platform",
      "compliance_stop"
    ],
    "parse_failure": {
      "cursor_advance": false,
      "delays_seconds": [
        300,
        900,
        1800
      ],
      "after_attempts": 3,
      "terminal": "dead_letter_and_manual_review"
    },
    "fence_rule": "every retry reloads authorization, stop status, source_config_epoch, source_safety_epoch and task-envelope fences"
  },
  "fifteen_minute_metrics": {
    "window_seconds": 900,
    "counters": [
      "poll_attempt_count",
      "poll_success_count",
      "items_seen_count",
      "new_identity_count",
      "duplicate_identity_count",
      "review_pending_count",
      "error_count"
    ],
    "per_item": [
      "published_at",
      "observed_at",
      "timestamp_confidence",
      "slo_eligible",
      "discovery_latency_ms",
      "within_15_minutes"
    ],
    "denominator": "only slo_eligible=true items",
    "empty_denominator": "unknown/not_measurable; never PASS",
    "current_candidate_expected": "not_measurable until an approved reliable publication timestamp path exists"
  },
  "pre_review_exit": {
    "required": [
      "authorized source active at current fences",
      "valid parse",
      "stable external identity",
      "normalization_status=valid",
      "dedup_status=unique or linked to existing",
      "rights_status retained without escalation",
      "Content.content_status=review_pending"
    ],
    "prohibited": [
      "automatic publication",
      "public projection",
      "Base write",
      "media fetch with unknown rights",
      "invented published_at"
    ]
  },
  "failure_exits": [
    {
      "condition": "no authorized automatic source",
      "state": "gate_closed_user_approval_required",
      "side_effects": "none"
    },
    {
      "condition": "missing GUID and canonical URL",
