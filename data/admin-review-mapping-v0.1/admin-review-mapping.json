  "transaction_protocol": {
    "approve_reservation": {
      "trigger": "POST /api/admin/reviews/{bundleId}/approve",
      "preconditions": ["current bundle/hash/summary/five-fence/manual_only/session/origin/csrf/CAS pass", "no conflicting terminal ReviewDecision", "unique publication aggregate is absent or byte-equivalent"],
      "writes": ["insert immutable ReviewDecision(approved)", "CAS Summary ready->approved", "CAS ReleaseBundle ready->approved", "CAS Content review_pending->approved->publish_queued in one unobservable transaction", "get-or-create exactly one Publication(queued) with stable publication_id/public_id/generation/idempotency_key/reconcile_key", "append redacted AuditEvent for operation receipt"],
      "forbidden_writes": ["OutboxJob", "TaskEnvelope", "PublishedProjection", "public-synthetic profile"],
      "commit_result": "ApproveSuccess exposes reserved Publication.public_id; admin publish route is now addressable; public story remains fail-closed",
      "failure_exit": "rollback all writes; return fixed conflict/stale/storage reason; do not reserve partial identity"
    },
    "manual_publish_enqueue": {
      "trigger": "POST /api/admin/publications/{publicId}/publish",
      "preconditions": ["resolve publicId to the single queued Publication", "Decision approved and bundle/hash/generation/five-fence/current guards pass", "same Publication.idempotency_key and reconcile_key"],
      "writes": ["get-or-create one OutboxJob(pending, operation_type=publish)", "embed one TaskEnvelope using Publication identity/key/five fences", "append redacted AuditEvent correlated to client operationId"],
      "forbidden_writes": ["new Publication", "new public_id", "PublishedProjection before confirmed publish", "public-synthetic profile"],
      "commit_result": "queued Publication has exactly one dispatch intent; repeated identical request returns same intent",
      "failure_exit": "rollback enqueue or return existing receipt; key/hash mismatch fails closed"
    },
    "manual_publish_completion": {
      "trigger": "leased publish worker completion or same-key reconciliation confirmation",
      "preconditions": ["fresh lease/deadline/attempt and current five fences", "Outbox/TaskEnvelope keys equal Publication keys", "approved hash and stable identity unchanged"],
      "writes": ["CAS Publication queued|retryable_failed->publishing when lease starts", "CAS Publication publishing|reconcile_wait->published on confirmed success", "CAS Content publish_queued->published", "insert exactly one PublishedProjection with same public_id/generation/published_version_hash", "mark OutboxJob succeeded and append redacted AuditEvent atomically with visible result"],
      "forbidden_writes": ["second Publication", "second public_id", "projection for non-published Publication", "cross-profile copy or ATTACH"],
      "commit_result": "same-profile projection-first GET /stories/{publicId} becomes readable only after full chain validation",
      "failure_exit": "unknown enters same Publication reconcile_wait; retry/terminal/stop preserve identity and keys"
    }
  },
  "reachability": {
    "admin_publish_path": {"becomes_addressable_after": "approve_reservation commit", "lookup": "Publication.public_id UNIQUE", "allowed_statuses": ["queued", "retryable_failed", "blocked", "reconcile_wait", "published"], "mutation_guard": "only queued or guarded retryable_failed may dispatch"},
    "public_story_path": {"before_projection": "404/fail_closed", "after_projection": "read PublishedProjection by public_id in the same selected physical profile", "cross_profile_copy": false, "static_fallback": false},
    "profile_constraint": "review write and its published projection must be read through one explicitly selected successor profile; this mapping does not authorize the profile, migration, or app change"
  },
