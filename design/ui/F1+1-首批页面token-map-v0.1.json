      "route_hint": "/ or /feed",
      "audience": "public",
      "layout": { "desktop": "featured 8+4 columns; story grid 3 columns", "tablet": "featured 5+3 columns; story grid 2 columns", "mobile": "single column; filters in drawer" },
      "components": ["F1TopBar", "F1PageHeader", "F1FeaturedStory", "F1StoryCard", "F1SourceMeta", "F1FilterBar", "F1FilterDrawer", "F1StatusBadge", "F1SkeletonCard", "F1EmptyState", "F1ErrorState", "F1NoMore", "F1Toast"],
      "states": ["loading", "empty", "error", "partial", "offline/restricted", "no-more", "live-refresh"],
      "a11y": ["main landmark", "feed list semantics", "polite new-content live region", "filter dialog focus return", "alt text"]
    },
    "content-detail": {
      "route_hint": "/story/:storyId",
      "audience": "public",
      "layout": { "desktop": "article body max 680px; evidence 4 columns; media max 960px", "tablet": "article 5 columns + evidence 3 columns", "mobile": "single column; evidence collapsible but source link visible" },
