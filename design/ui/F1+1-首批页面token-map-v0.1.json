    "F1Field": { "appica_reference": ["Field", "Form", "Input"], "variants": ["text", "url", "textarea", "select"], "states": ["default", "focus", "filled", "readonly", "disabled", "invalid", "loading"] },
    "F1Toast": { "appica_reference": ["Toast"], "variants": ["success", "warning", "error", "info"], "states": ["enter", "visible", "exit", "reduced-motion"] }
