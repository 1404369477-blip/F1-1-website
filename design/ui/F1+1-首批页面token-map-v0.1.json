      "states": ["loading", "not-found", "error", "withdrawn", "media-missing", "source-restricted", "correction"],
      "a11y": ["article semantics", "breadcrumb aria-current", "heading hierarchy", "media-caption association", "source-link accessible name"]
    },
    "review-queue": {
      "route_hint": "/admin/review",
      "audience": "reviewer",
      "layout": { "desktop": "filter full width; list 4 columns + detail 8 columns", "tablet": "list 3 columns + detail 5 columns", "mobile": "list and detail sequential; detail/action drawer" },
      "components": ["F1TopBar", "F1AdminPageHeader", "F1ReviewFilterBar", "F1ReviewList", "F1ReviewListItem", "F1ReviewDetail", "F1EvidenceBlock", "F1OriginalTextPanel", "F1DraftEditor", "F1MediaCandidate", "F1VersionMeta", "F1ReviewActionBar", "F1ConfirmDialog", "F1ReviewEmptyState", "F1ReviewErrorState", "F1ReviewSkeleton"],
      "states": ["loading-list", "empty", "loading-detail", "pending-review", "saving", "saved-needs-review", "approve-confirm", "reject-confirm", "stale-version", "error", "partial"],
      "actions": ["save-draft", "approve", "reject"],
      "a11y": ["queue selection semantics", "label-help-error association", "dialog focus trap", "polite stale/save announcements", "keyboard action completion"]
    },
    "source-management": {
      "route_hint": "/admin/sources",
      "audience": "admin",
      "layout": { "desktop": "filter full width; table 12 columns; detail drawer", "tablet": "key columns + expandable row", "mobile": "card detail row + full-screen detail/form drawer" },
      "components": ["F1TopBar", "F1AdminPageHeader", "F1SourceFilterBar", "F1DataTable", "F1SourceRow", "F1SourceStatusBadge", "F1LastCollected", "F1ErrorDisclosure", "F1SourceDetailDrawer", "F1AddSourceForm", "F1UrlField", "F1CapabilityList", "F1SourceEmptyState", "F1SourceSkeleton", "F1SourceErrorState"],
      "states": ["proposed", "normalization_pending", "dedupe_pending", "adapter_check_pending", "enqueued", "enabled", "manual_only", "restricted", "failed", "disabled", "unknown"],
      "a11y": ["semantic table", "aria-sort", "expanded row controls", "URL label/error/copy", "confirmation dialog for destructive actions"]
