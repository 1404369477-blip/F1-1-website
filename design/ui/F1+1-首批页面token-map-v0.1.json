  "components": {
    "F1TopBar": { "appica_reference": ["Navigation", "NavigationMenu"], "variants": ["desktop", "tablet", "mobile"], "states": ["default", "scrolled", "menu-closed", "menu-open", "theme-switching", "reduced-motion"] },
    "F1Button": { "appica_reference": ["Button", "ButtonGroup"], "variants": ["primary", "secondary", "ghost", "destructive", "icon"], "states": ["default", "hover", "focus-visible", "pressed", "disabled", "loading"] },
    "F1StoryCard": { "appica_reference": ["Card-like composition"], "variants": ["featured", "standard", "compact", "media-missing"], "states": ["default", "hover", "focus-visible", "loading", "error"] },
    "F1StatusBadge": { "appica_reference": ["Badge", "Chip"], "variants": ["unknown", "queued", "pending-review", "success", "disabled", "failed", "blocked"] },
